# Optional. The app works without it: Mainnet and Sepolia fall back to free
# public RPCs (Lava / Blast). Set an Alchemy Starknet key here only if you want
# to use Alchemy's endpoints instead. Get one free at https://alchemy.com.
# Paste ONLY the key (the part after .../v2/), never the full URL.
NEXT_PUBLIC_PROVIDER_URL=

# (Optional) Your echo/anonymizer helper deployed on Sepolia. Leave as 0x0 if
# not deployed; you can deploy one from the app's Echo tab and paste the
# returned address here.
NEXT_PUBLIC_STRK20_ECHO_HELPER_SEPOLIA=0x0
